---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" href="/favicon.ico"/>
    <meta name="generator" content={Astro.generator}/>
    <title>Astro Basics</title>
</head>
<body>
<nav id="navbar" class="w-full px-24 py-5 flex flex-row justify-between items-center border-b border-brand-light-gray">
    <h1 class="text-[13px] text-brand-primary">
        Lionheart Pacific
    </h1>
    <div class="flex flex-row gap-x-2 items-center">
        <h1 class="text-[13px] text-brand-primary">
            Practices
        </h1>
        <h1 class="text-[13px] text-brand-primary">
            Services
        </h1>
        <h1 class="text-[13px] text-white bg-brand-primary rounded-sm p-2">
            Let's talk
        </h1>
    </div>
</nav>
<slot/>
<footer id="footer" class="w-full px-24 py-16 flex flex-row justify-between items-center">
    <div class="flex flex-col h-fit gap-y-3">
        <div class="size-18 bg-brand-primary"></div>
        <div class="text-[13px] text-brand-mid-gray">© 2026 · Lionheart Pacific</div>
    </div>
    <div class="flex flex-col h-fit gap-y-3">
        <h1 class="text-[13px] text-brand-mid-gray">
            EXPLORE
        </h1>
        <div class="text-[13px] text-brand-ink">
            Practices
        </div>
        <div class="text-[13px] text-brand-ink">
            Services
        </div>
        <div class="text-[13px] text-brand-ink">
            Contact
        </div>
    </div>
</footer>
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
