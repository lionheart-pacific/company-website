---
import Layout from '../layouts/Layout.astro'
import LetsTalkSection from '../components/LetsTalkSection.astro'
import services from '../data/services.json'
---

<Layout hasNavbar={true}>
  <div class="px-6 md:px-24 pt-16 pb-12 md:pt-28 md:pb-20 border-b border-brand-light-gray">
    <h1 class="text-h1 text-brand-ink font-semibold">Services</h1>
  </div>
  {
    services.map((service) => (
      <section
        class:list={[
          'px-6 md:px-24 py-16 md:py-24 flex flex-col gap-5 md:gap-8',
          service.highlighted && 'bg-brand-concrete',
        ]}
      >
        <h2 class="text-h2 text-brand-ink font-semibold">{service.name}</h2>
        <div class="flex flex-col gap-4 md:gap-6">
          <p class="text-h3 font-medium text-brand-ink max-w-[55ch]">{service.tagline}</p>
          {service.paragraphs.map((paragraph) => (
            <p class="text-body-lg text-brand-dark-gray max-w-[65ch]">{paragraph}</p>
          ))}
        </div>
      </section>
    ))
  }
  <LetsTalkSection body="Have a challenging problem? We’d love to hear what you’re building." />
</Layout>
