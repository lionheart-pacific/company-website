---
import Layout from '../layouts/Layout.astro';
import LetsTalkSection from "../components/LetsTalkSection.astro";

const services = [
    {
        name: "Product Development",
        tagline: "Build software with a team that owns the outcome.",
        paragraphs: [
            "We provide dedicated product teams of cross-functional engineers who treat product, design, and engineering as one craft. Our software engineering team is based in Thailand, where we’ve built a stable, collaborative organization designed for long-term product development.",
            "Every engagement pairs the team with a Delivery Lead, your primary point of contact, who stays close to your business and its priorities. The team collectively owns the product from concept to production.",
        ],
        highlighted: false,
    },
    {
        name: "Compliance Engineering",
        tagline: "Compliance doesn’t have to stand in the way of operational excellence.",
        paragraphs: [
            "The best compliant solution is rarely the most conservative one. Most organizations read the rules defensively and rule out innovative solutions the frameworks would allow. We read them closely and keep finding room for both stronger compliance and better systems.",
            "Recently, our team brought a new SaaS product to market under FedRAMP with software engineering based in Thailand. Demanding compliance doesn’t rule out global talent. It rules out partners who don’t know the framework.",
        ],
        highlighted: true,
    },
]
---

<Layout hasNavbar={true}>
    <div class="px-6 md:px-24 pt-13 md:pt-30 pb-9 md:pb-30 border-b border-brand-light-gray">
        <h1 class="text-[38px] md:text-h1 text-brand-ink font-semibold leading-[1.08]">Services</h1>
    </div>
    {services.map((service) => (
        <section class:list={[
            "px-6 md:px-24 py-10 md:py-30 flex flex-col gap-5 md:gap-12",
            service.highlighted && "bg-brand-concrete",
        ]}>
            <h2 class="text-[26px] md:text-h2 text-brand-ink font-semibold">{service.name}</h2>
            <div class="flex flex-col gap-4 md:gap-7">
                <p class="text-[18px] md:text-[24px] font-medium text-brand-ink">{service.tagline}</p>
                {service.paragraphs.map((paragraph) => (
                    <p class="text-[16px] md:text-subtitle1 text-brand-dark-gray">{paragraph}</p>
                ))}
            </div>
        </section>
    ))}
    <LetsTalkSection body="Have a challenging problem? We’d love to hear what you’re building."/>
</Layout>
