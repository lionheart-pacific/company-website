---
import Layout from '../layouts/Layout.astro'
import NavBar from '../components/NavBar.astro'
import LetsTalkSection from '../components/LetsTalkSection.astro'
import services from '../data/services.json'
---

<Layout>
  <NavBar />
  <div class="border-b border-brand-light-gray pt-16 pb-12 md:pt-28 md:pb-20">
    <div class="site-container flex flex-col gap-5 md:gap-7">
      <h1 class="text-h1 text-brand-ink font-semibold">Your next software partner</h1>
      <p class="text-body-lg text-brand-dark-gray max-w-2xl">
        We own what we build, from new product development to demanding compliance. Here’s what we
        do.
      </p>
    </div>
  </div>
  {
    services.map((service) => (
      <section class:list={['py-16 md:py-24', service.highlighted && 'bg-brand-concrete']}>
        <div class="site-container flex flex-col gap-5 md:gap-8">
          <h2 class="text-h2 text-brand-ink font-semibold">{service.name}</h2>
          <div class="flex flex-col gap-4 md:gap-6">
            <p class="text-h3 font-medium text-brand-ink max-w-[55ch]">{service.tagline}</p>
            {service.paragraphs.map((paragraph) => (
              <p class="text-body-lg text-brand-dark-gray max-w-2xl">{paragraph}</p>
            ))}
          </div>
        </div>
      </section>
    ))
  }
  <LetsTalkSection>
    Have a challenging problem? We’d love to hear what you’re building.
  </LetsTalkSection>
</Layout>
