---
import Layout from '../layouts/Layout.astro'
import HeroSection from '../components/HeroSection.astro'
import NavBar from '../components/NavBar.astro'
import LetsTalkSection from '../components/LetsTalkSection.astro'
import QuoteMark from '../components/QuoteMark.astro'

const heroSpacerId = 'hero-spacer'
const quote =
  'Partnering with Lionheart Pacific has been one of the best decisions we’ve made. They bring thoughtful judgment, real ownership, and a depth of experience that’s difficult to find. We’ve trusted them with software that’s critical to our business, and they’ve consistently been invested in our long-term success as if it were their own.'
---

<Layout>
  <NavBar overlay sentinelId={heroSpacerId} />
  <HeroSection spacerId={heroSpacerId} />
  <section class="site-container flex flex-col py-16 gap-14 md:py-24 md:gap-20">
    <div class="flex flex-col gap-5 md:gap-8">
      <h2 class="text-h2 font-semibold text-brand-ink">
        Business-critical software needs stewardship
      </h2>
      <div class="flex flex-col gap-4 md:gap-6">
        <p class="text-body-lg text-brand-dark-gray max-w-[65ch]">
          Whether you’re building a new product, scaling an established platform, or maintaining the
          systems your business depends on, successful software requires more than implementation.
          It needs a partner that understands the product, practices principled engineering, and
          stays invested in its long-term success.
        </p>
        <a href="/practices" class="text-body font-medium text-brand-primary hover:underline">
          Learn how we work →
        </a>
      </div>
    </div>
    <hr class="border-brand-light-gray" />
    <div class="flex flex-col gap-5 md:gap-8">
      <h2 class="text-h2 font-semibold text-brand-ink">Designed to deliver</h2>
      <div class="flex flex-col gap-4 md:gap-6">
        <p class="text-body-lg text-brand-dark-gray max-w-[65ch]">
          Ambitious outcomes are rarely achieved through a series of short projects. That’s why
          Lionheart Pacific is built around long-term relationships, stable teams, and experienced,
          cross-functional engineers. We deliver the quality you’d expect from a premium engineering
          firm, at a cost you can sustain.
        </p>
        <a href="/services" class="text-body font-medium text-brand-primary hover:underline">
          See our services →
        </a>
      </div>
    </div>
  </section>
  <section class="bg-brand-concrete py-16 md:py-24">
    <div class="site-container flex flex-col items-start gap-6 md:gap-8">
      <h2 class="text-h2 font-semibold text-brand-ink">In their words</h2>
      <blockquote class="relative max-w-[60ch]">
        <QuoteMark class="hidden md:block" />
        <p class="text-h3 text-brand-dark-gray">
          <span class="hidden md:inline">{quote}</span>
          <span class="md:hidden">“{quote}”</span>
        </p>
      </blockquote>
      <div class="text-body-lg leading-snug flex flex-col items-start">
        <div class="font-semibold text-brand-ink">John Doe, Co-Founder</div>
        <div class="text-brand-mid-gray">Acme LLC</div>
        <div class="text-body text-brand-mid-gray">Inc. 5000 in 2025 and 2026</div>
      </div>
    </div>
  </section>
  <LetsTalkSection
    body="What are you building? We’d love to learn about your business, the challenges you’re facing, and where you’re headed."
  />
</Layout>
