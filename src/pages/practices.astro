---
import Layout from '../layouts/Layout.astro';
import LetsTalkSection from "../components/LetsTalkSection.astro";
import InfoCard from "../components/InfoCard.astro";

const howWeBuild = [
    {
        label: "Quality never rests on one person.",
        description: "We pair. Two engineers work as one — context stays shared, knowledge spreads across the team, and design decisions get pressure-tested as they’re made.",
    },
    {
        label: "The system stays provably correct as it changes.",
        description: "Test-driven development. We write the test first, so regressions surface the moment they appear and “done” always means the same thing.",
    }, {
        label: "Never risky, always routine.",
        description: "Continuous delivery. The software stays shippable at all times, shipped in small, low-risk increments.",
    }, {
        label: "Decisions get made with full context.",
        description: "Product- and design-minded engineers. Technical, usability, and business trade-offs are weighed together, not handed across walls.",
    },{
        label: "Momentum holds as priorities shift.",
        description: "Steady cycles, continuous prioritization. We plan deliberately but stay flexible, reviewing priorities as we learn from the work and your needs.",
    },
]
---

<Layout hasNavbar={true}>
    <div class=" ">
        <div class="px-6 md:px-24 pt-13 md:pt-30 pb-9 md:pb-20 flex flex-col gap-y-5 md:gap-y-7 border-b border-brand-light-gray">
            <div class="text-overline text-brand-primary uppercase font-semibold">practices</div>
            <h1 class="text-[38px] md:text-h1 text-brand-ink font-semibold leading-[1.08]">Excellent software isn’t an accident.</h1>
            <p class="text-[16px] md:text-subtitle1 text-brand-dark-gray w-full md:w-1/2">It comes from a set of practices applied consistently, and from teams that own their work. Here’s how we build.</p>
        </div>
        <div class="px-6 md:px-24 py-9 md:py-21 flex flex-col gap-3 md:gap-7 border-b border-brand-light-gray">
            <div class="text-overline text-brand-primary uppercase scroll-mt-21" id="how-we-build">HOW WE BUILD</div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {howWeBuild.map((item) => (
                    <InfoCard label={item.label} description={item.description}/>
                ))}
            </div>
        </div>
        <div class="px-6 md:px-24 py-11 md:py-21 flex flex-col gap-3 md:gap-7 border-b border-brand-light-gray bg-brand-concrete">
            <div class="text-overine text-brand-primary uppercase font-semibold">OWNERSHIP</div>
            <h1 class="text-brand-ink font-semibold text-[22px] md:text-[36px] leading-[1.24]">The best software comes from teams that own their work.</h1>
            <p class="text-[15px] md:text-subtitle1 text-brand-dark-gray w-full md:w-1/2">We organize around clear ownership: a team responsible for a meaningful area, with the autonomy to make decisions inside well-defined boundaries. That is what creates short feedback loops, fast decisions, and real accountability — while staying closely connected to the people, systems, and priorities around it.</p>
        </div>

        <div class="px-6 md:px-24 py-9 md:py-21 flex flex-col gap-3 md:gap-7 border-b border-brand-light-gray ">
            <div class="text-overine text-brand-primary uppercase font-semibold">THE OUTCOME</div>
            <h1 class="text-brand-ink font-semibold md:text-[28px] text-[21px] leading-[1.40]">Over time, software delivery becomes part of your normal business rhythm — steady, visible, and easy to plan around, rather than a recurring source of risk.</h1>
        </div>
    </div>

    <LetsTalkSection/>
</Layout>
