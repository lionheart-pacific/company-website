---
import Layout from '../layouts/Layout.astro'
import NavBar from '../components/NavBar.astro'
import LetsTalkSection from '../components/LetsTalkSection.astro'
import InfoCard from '../components/InfoCard.astro'
import practices from '../data/practices.json'
---

<Layout>
  <NavBar />
  <div class="border-b border-brand-light-gray pt-16 pb-12 md:pt-28 md:pb-20">
    <div class="site-container flex flex-col gap-5 md:gap-7">
      <h1 class="text-h1 text-brand-ink font-semibold">Successful software isn’t an accident</h1>
      <p class="text-body-lg text-brand-dark-gray max-w-[65ch]">
        It comes from disciplined engineering practices, applied consistently by teams that are
        equipped and empowered to own their work. Here’s how we build.
      </p>
    </div>
  </div>
  <div
    class:list={[
      'site-container py-12 md:py-24',
      'grid gap-4 md:gap-6',
      'grid-cols-[repeat(auto-fill,minmax(max(min(100%,22rem),calc((100%-4.5rem)/4+1px)),1fr))]',
    ]}
  >
    {practices.map((item) => <InfoCard label={item.label} description={item.description} />)}
  </div>
  <LetsTalkSection>
    Did you find yourself nodding along? Or even disagreeing? Either way, let’s talk shop. We’d love
    to hear what you’re building.
  </LetsTalkSection>
</Layout>
