
---
import {
    Astronav,
    MenuItems,
    MenuIcon,
} from "astro-navbar";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="w-full px-6 md:px-24 py-5 md:flex md:flex-row justify-between items-center border-b border-brand-light-gray ">
    <Astronav closeOnClick>
        <div class="flex w-full md:w-auto justify-between items-center">
            <a href="/" class="text-[18px] md:text-[24px] text-brand-primary font-logo">
                Lionheart Pacific
            </a>
            <div class="block md:hidden">
                <MenuIcon class="w-4 h-4 text-gray-800" />
            </div>
        </div>
        <MenuItems class="mt-4 hidden md:mt-0 md:flex md:w-auto w-full">
            <ul class="flex flex-col md:flex-row md:gap-7">
                <li>
                    <a href="/practices" class="text-[13px] text-brand-primary">
                        Practices
                    </a>
                </li>
                <li>
                    <a href="/services" class="text-[13px] text-brand-primary">
                        Services
                    </a>
                </li>
                <li>
                    <a href="/contact" class="text-[13px] text-white bg-brand-primary rounded-sm p-2 w-fit">
                        Let's talk
                    </a>
                </li>

            </ul>
        </MenuItems>
    </Astronav>
</header>

