---
type Props = { overlay?: false; sentinelId?: never } | { overlay: true; sentinelId: string }

const { overlay = false, sentinelId } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header
  class:list={[
    'group top-0 z-40 w-full py-5',
    overlay
      ? 'fixed inset-x-0 transition-colors duration-300 data-scrolled:bg-white data-scrolled:border-b data-scrolled:border-brand-light-gray'
      : 'sticky bg-white border-b border-brand-light-gray',
  ]}
  data-nav-overlay={overlay || undefined}
  data-sentinel={sentinelId && `#${sentinelId}`}
>
  <div class="site-container flex items-center justify-between">
    <a
      href="/"
      class:list={[
        'font-logo text-wordmark text-brand-primary',
        overlay && [
          'opacity-0 pointer-events-none transition-opacity duration-300',
          'group-data-scrolled:opacity-100 group-data-scrolled:pointer-events-auto',
        ],
      ]}
    >
      Lionheart Pacific
    </a>

    <button
      type="button"
      popovertarget="primary-navigation"
      aria-label="Toggle menu"
      class:list={[
        'block md:hidden cursor-pointer',
        overlay
          ? 'text-brand-concrete transition-colors group-data-scrolled:text-brand-ink'
          : 'text-brand-ink',
      ]}
    >
      <svg
        class="size-6"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M4 5h16a1 1 0 010 2H4a1 1 0 110-2zm0 6h16a1 1 0 010 2H4a1 1 0 010-2zm0 6h16a1 1 0 010 2H4a1 1 0 010-2z"
        ></path>
      </svg>
    </button>

    <nav
      popover
      id="primary-navigation"
      aria-label="Primary navigation"
      class:list={[
        'fixed inset-auto top-19 right-6 m-0 p-0 w-56',
        'overflow-hidden rounded-sm border border-brand-light-gray bg-white shadow-lg',
        'md:static md:flex md:w-auto',
        'md:overflow-visible md:border-0 md:bg-transparent md:shadow-none',
      ]}
    >
      <ul class="flex flex-col md:flex-row md:items-center md:gap-8">
        <li class="border-b border-brand-light-gray md:border-0">
          <a
            href="/practices"
            aria-current={currentPath === '/practices' ? true : undefined}
            class:list={[
              'block px-5 text-nav text-brand-primary',
              'transition-colors hover:bg-brand-concrete md:p-0 md:hover:bg-transparent md:hover:underline',
              'aria-current:bg-brand-concrete md:aria-current:bg-transparent md:aria-current:underline',
              overlay && 'md:text-brand-concrete md:group-data-scrolled:text-brand-primary',
            ]}
          >
            Practices
          </a>
        </li>

        <li class="border-b border-brand-light-gray md:border-0">
          <a
            href="/services"
            aria-current={currentPath === '/services' ? true : undefined}
            class:list={[
              'block px-5 text-nav text-brand-primary',
              'transition-colors hover:bg-brand-concrete md:p-0 md:hover:bg-transparent md:hover:underline',
              'aria-current:bg-brand-concrete md:aria-current:bg-transparent md:aria-current:underline',
              overlay && 'md:text-brand-concrete md:group-data-scrolled:text-brand-primary',
            ]}
          >
            Services
          </a>
        </li>

        <li>
          <a
            href="/contact"
            aria-current={currentPath === '/contact' ? true : undefined}
            class:list={[
              'block px-5 text-nav md:rounded-sm md:border',
              'text-brand-primary transition-colors max-md:hover:bg-brand-concrete',
              'aria-current:bg-brand-concrete md:aria-current:bg-transparent',
              'md:hover:opacity-90',
              overlay
                ? [
                    'md:border-brand-concrete md:text-brand-concrete',
                    'md:group-data-scrolled:border-brand-primary md:group-data-scrolled:bg-brand-primary md:group-data-scrolled:text-white',
                  ]
                : 'md:border-brand-primary md:bg-brand-primary md:text-white md:aria-current:text-brand-primary',
            ]}
          >
            Let’s talk
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  let navScrollObserver: IntersectionObserver | undefined

  const initializeNavScroll = () => {
    const nav = document.querySelector<HTMLElement>('[data-nav-overlay]')
    const sentinel = nav?.dataset.sentinel
      ? document.querySelector<HTMLElement>(nav.dataset.sentinel)
      : null

    if (!nav || !sentinel) {
      return
    }

    navScrollObserver?.disconnect()
    navScrollObserver = new IntersectionObserver(
      ([entry]) => {
        nav.toggleAttribute('data-scrolled', !entry.isIntersecting)
      },
      { rootMargin: `-${nav.offsetHeight}px 0px 0px 0px` },
    )
    navScrollObserver.observe(sentinel)
  }

  document.addEventListener('astro:after-swap', initializeNavScroll)
  initializeNavScroll()
</script>
