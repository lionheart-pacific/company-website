---
import Logo from './Logo.astro'
---

<footer id="footer" class="w-full py-12 md:py-16 border-t border-brand-light-gray">
  <div
    class="site-container flex flex-col-reverse gap-10 items-center md:flex-row md:justify-between md:gap-0"
  >
    <div class="flex flex-col items-center gap-2 md:gap-3">
      <Logo class="text-4xl text-brand-primary" />
      <div class="text-small text-brand-mid-gray">© 2026 Lionheart Pacific</div>
    </div>
    <div class="flex flex-row md:flex-col gap-6 md:gap-3">
      <a href="/practices" class="text-nav md:text-small text-brand-ink hover:underline">
        Practices
      </a>
      <a href="/services" class="text-nav md:text-small text-brand-ink hover:underline">
        Services
      </a>
      <a href="/contact" class="text-nav md:text-small text-brand-ink hover:underline"> Contact </a>
    </div>
  </div>
</footer>
