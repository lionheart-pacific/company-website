---
interface Props {
  label: string
  description: string
}

const { label, description } = Astro.props
---

<div class="bg-brand-concrete p-6 md:p-9 gap-2 flex flex-col rounded-md">
  <div class="text-brand-ink text-[19px] font-semibold">{label}</div>
  <div class="text-brand-dark-gray text-[16px]">{description}</div>
</div>
