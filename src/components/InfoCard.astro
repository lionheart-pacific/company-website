---
interface Props {
  label: string
  description: string
}

const { label, description } = Astro.props
---

<div class="bg-brand-concrete p-6 md:p-8 gap-2.5 flex flex-col rounded-md">
  <div class="text-brand-ink text-h3 font-semibold">{label}</div>
  <div class="text-brand-dark-gray text-body">{description}</div>
</div>
