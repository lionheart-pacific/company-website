---
import oceanImage from '../assets/ocean.jpg'
import { Picture } from 'astro:assets'
import Logo from './Logo.astro'

interface Props {
  spacerId?: string
}

const { spacerId } = Astro.props
---

<div class="bg-white dark:bg-gray-900">
  <div class="relative isolate overflow-hidden pt-14 min-h-[75dvh] flex flex-col">
    <Picture
      src={oceanImage}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="flex-1" id={spacerId}></div>
    <div
      class:list={[
        'site-container',
        'flex',
        'flex-col lg:flex-row',
        'justify-end lg:justify-start',
        'pb-16 lg:pb-25',
        'gap-x-13',
        'gap-y-6 lg:gap-y-0',
        'text-brand-concrete',
        'items-center',
      ]}
    >
      <Logo class="text-[64px]" />
      <div
        class:list={[
          'flex flex-col',
          'lg:border-l lg:border-l-brand-concrete',
          'lg:pl-13',
          'gap-y-6 lg:gap-y-8',
        ]}
      >
        <div class="group/heading relative text-h2 lg:text-h1" data-hero-heading data-stacked>
          <span class="group-data-stacked/heading:block">The dependable team</span>
          {' '}
          <span class="group-data-stacked/heading:block">for business-critical software</span>
          <span
            class="absolute invisible whitespace-nowrap"
            aria-hidden="true"
            data-hero-heading-probe
          >
            for business-critical software
          </span>
        </div>
        <div class="text-body-lg lg:text-h3 font-light">
          Lionheart Pacific provides software development and stewardship through principled
          engineering.
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let heroHeadingObserver: ResizeObserver | undefined

  const initializeHeroHeading = () => {
    const heading = document.querySelector<HTMLElement>('[data-hero-heading]')
    const probe = heading?.querySelector<HTMLElement>('[data-hero-heading-probe]')

    if (!heading || !probe) {
      return
    }

    const update = () => {
      heading.toggleAttribute('data-stacked', probe.offsetWidth <= heading.clientWidth)
    }

    heroHeadingObserver?.disconnect()
    heroHeadingObserver = new ResizeObserver(update)
    heroHeadingObserver.observe(heading)
    document.fonts?.ready.then(update)
    update()
  }

  document.addEventListener('DOMContentLoaded', initializeHeroHeading, { once: true })
  document.addEventListener('astro:after-swap', initializeHeroHeading)
</script>
