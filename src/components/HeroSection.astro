---
import oceanImage from '../assets/ocean.jpg'
import {Picture} from "astro:assets";
import Logo from './Logo.astro';
import {Astronav, MenuIcon, MenuItems} from "astro-navbar";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
// Make component navbar usable here.
---

<div class="bg-white dark:bg-gray-900">
    <div class="relative isolate overflow-hidden pt-14">
        <header class="w-full px-6 py-5 md:px-24">
            <div class="relative flex justify-end" data-navbar-root>
                <Astronav closeOnClick>
                    <div class="flex w-full items-center justify-end md:w-auto">

                        <div class="block md:hidden">
                            <MenuIcon class="size-5 text-brand-concrete" />
                        </div>
                    </div>

                    <MenuItems
                            aria-label="Primary navigation"
                            class="absolute right-0 top-full z-50 mt-3 hidden w-48 overflow-hidden rounded-sm border border-brand-light-gray bg-white shadow-lg md:static md:z-auto md:mt-0 md:flex md:w-auto md:overflow-visible md:border-0 md:bg-transparent md:shadow-none"
                    >
                        <ul class="flex flex-col md:flex-row md:items-center md:gap-7">
                            <li class="border-b border-brand-light-gray md:border-0">
                                <a
                                        href="/practices"
                                        aria-current={currentPath === "/practices" ? "page" : undefined}
                                        class:list={[
                                            "block px-4 py-3 text-[13px] text-brand-ink md:text-brand-concrete transition-colors hover:bg-brand-concrete md:p-0 md:hover:bg-transparent md:hover:underline",
                                            currentPath === "/practices" && "bg-brand-concrete md:bg-transparent md:underline",
                                        ]}
                                >
                                    Practices
                                </a>
                            </li>

                            <li class="border-b border-brand-light-gray md:border-0">
                                <a
                                        href="/services"
                                        aria-current={currentPath === "/services" ? "page" : undefined}
                                        class:list={[
                                            "block px-4 py-3 text-[13px]  text-brand-ink md:text-brand-concrete transition-colors hover:bg-brand-concrete md:p-0 md:hover:bg-transparent md:hover:underline",
                                            currentPath === "/services" && "bg-brand-concrete md:bg-transparent md:underline",
                                        ]}
                                >
                                    Services
                                </a>
                            </li>

                            <li>
                                <a
                                        href="/contact"
                                        aria-current={currentPath === "/contact" ? "page" : undefined}
                                        class="block bg-brand-primary md:bg-brand-concrete px-4 py-3 text-[13px] text-brand-concrete md:text-brand-ink transition-opacity hover:opacity-90 md:rounded-sm md:p-2"
                                >
                                    Let's talk
                                </a>
                            </li>
                        </ul>
                    </MenuItems>
                </Astronav>
            </div>
        </header>
        <Picture
                src={oceanImage}
                alt=""
                formats={['avif', 'webp']}
                widths={[640, 960, 1280, 1600, 2000]}
                sizes="100vw"
                loading="eager"
                decoding="async"
                class="absolute inset-0 -z-10 size-full object-cover"
        />
        <div class="flex min-h-150
        flex-col md:flex-row
        p-8 md:pb-25 md:px-35
        gap-x-13
        gap-y-6 md:gap-y-0
        text-brand-concrete
        items-center
        md:items-end
        ">
            <Logo/>
            <div class="flex flex-col
            md:border-l-brand-concrete md:border-l
            md:pl-13
            gap-y-6 md:gap-y-4">
                <div class="text-[32px] md:text-h2
                leading-9 md:leading-13">
                    A dependable software team you can plan your business around.
                </div>
                <div class="text-sm md:text-subtitle1 font-thin">
                    Lionheart Pacific provides exceptional, ongoing product development through principled engineering
                    practices.
                </div>
                <div class="text-overline">
                    Schedule a conversation →
                </div>
            </div>
        </div>
        <div aria-hidden="true"
             class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]">
            <div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
                 class="relative left-[calc(50%+3rem)] aspect-1155/678 w-144.5 -translate-x-1/2 bg-linear-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%+36rem)] sm:w-288.75"></div>
        </div>
    </div>
</div>