---
import oceanImage from '../assets/ocean.jpg'
import {Picture} from "astro:assets";
import WaveMark from  '../assets/wave-mark.svg'
import Layout from "../layouts/Layout.astro";
import Services from "./Services.tsx";
import LetsTalkSection from "./LetsTalkSection.astro";
import Logo from './Logo.astro';
---

<div class="bg-white dark:bg-gray-900">
    <div class="relative isolate overflow-hidden pt-14">
        <div class=" w-full px-24 py-5
        hidden md:flex md:flex-row justify-items-end justify-end
        bg-transparent">
            <div class="flex flex-row gap-x-2 items-center">
                <a href="/practices" class="text-[13px] text-brand-concrete">
                    Practices
                </a>
                <a href="/services" class="text-[13px] text-brand-concrete">
                    Services
                </a>
                <h1 class="text-[13px] text-brand-concrete border-brand-concrete border rounded-sm p-2">
                    Let's talk
                </h1>
            </div>
        </div>
        <Picture
                src={oceanImage}
                alt=""
                formats={['avif', 'webp']}
                widths={[640, 960, 1280, 1600, 2000]}
                sizes="100vw"
                loading="eager"
                decoding="async"
                class="absolute inset-0 -z-10 size-full object-cover"
        />
        <div class="flex min-h-150
        flex-col md:flex-row
        p-8 md:pb-25 md:px-35
        gap-x-13
        gap-y-6 md:gap-y-0
        text-brand-concrete
        items-center
        md:items-end
        ">
            <Logo/>
            <div class="flex flex-col
            md:border-l-brand-concrete md:border-l
            md:pl-13
            gap-y-6 md:gap-y-4">
                <div class="text-[32px] md:text-h2
                leading-9 md:leading-13">
                    A dependable software team you can plan your business around.
                </div>
                <div class="text-sm md:text-subtitle1 font-thin">
                    Lionheart Pacific provides exceptional, ongoing product development through principled engineering
                    practices.
                </div>
                <div class="text-overline">
                    Schedule a conversation →
                </div>
            </div>
        </div>
        <div aria-hidden="true"
             class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]">
            <div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
                 class="relative left-[calc(50%+3rem)] aspect-1155/678 w-144.5 -translate-x-1/2 bg-linear-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%+36rem)] sm:w-288.75"></div>
        </div>
    </div>
</div>