---
import WaveMark from "../assets/wave-mark.svg";
interface Props {
    width?: number;
    height?: number;
    fontSize?: number;
    lineHeight?: number;
    color?: string
}
const {width = 140, height = 64, fontSize = 64, lineHeight = 64, color="#F2F2F2"} = Astro.props;
---
<div class=`flex flex-col gap-0 items-center ${color}`>
    <WaveMark width={width} height={height}/>
    <div
           style={{
               fontSize: `${fontSize}px`,
               lineHeight: `${lineHeight}px`,
           }}
            class=`font-logo text-center`>
        Lionheart<br/>Pacific
    </div>
</div>